# Neon serverless Postgres connection string
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/chorewheel?sslmode=require"

# Dev-only: id of the `members` row to treat as "signed in" until real auth
# (step 7) replaces this. Set after running `npm run seed`.
DEV_MEMBER_ID=""

# Auth.js (step 7)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email provider for magic links — Resend
RESEND_API_KEY=""
EMAIL_FROM="Chore Wheel <onboarding@yourdomain.com>"

# Realtime: board/mine/admin poll via router.refresh() every 7s (see
# src/components/PollingRefresher.tsx) — no Pusher setup needed.
